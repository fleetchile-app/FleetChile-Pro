PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fleetchile
GEOCODING_PROVIDER=nominatim
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=FleetChile-Pro/1.0 (contacto@ejemplo.cl)
ROUTING_PROVIDER=osrm
ROUTING_BASE_URL=https://router.project-osrm.org
# Alternativa gratuita opcional. Seleccionar ambos PROVIDER=openrouteservice;
# las BASE_URL anteriores se ignoran al seleccionar este proveedor.
ORS_API_KEY=
ORS_ROUTING_PROFILE=driving-car
ORS_DIRECTIONS_DAILY_LIMIT=2000
ORS_DIRECTIONS_MINUTE_LIMIT=40
# Tope conservador local; ajustar solo tras confirmar la cuota de la cuenta.
ORS_GEOCODING_DAILY_LIMIT=1000
ORS_GEOCODING_MINUTE_LIMIT=100
# Los valores públicos anteriores son legacy/de demostración. El nuevo selector
# exige endpoints autorizados (Nominatim-compatible y OSRM-compatible) para
# búsqueda y cálculo comercial. El mapa y las ubicaciones no dependen de ellos.
MIGRATION_LOCK_TIMEOUT_MS=5000
MIGRATION_STATEMENT_TIMEOUT_MS=120000
# PostgreSQL remoto: validar CA antes de activar DATABASE_SSL_VERIFY.
DATABASE_SSL=false
DATABASE_SSL_VERIFY=false
DATABASE_SSL_CA_BASE64=
# Bucket PRIVADO, credenciales acotadas a los objetos de FleetChile.
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Copias de portabilidad: temporales, no respaldos.
EXPORT_MAX_BYTES=104857600
EXPORT_MAX_ROWS=1000000
EXPORT_MAX_FILES=10000
EXPORT_TIMEOUT_MS=600000
MONITOR_TECHNICAL_DAYS=30
